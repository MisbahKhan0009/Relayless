{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relayless",
  "mainBinaryName": "Relayless",
  "version": "0.1.0",
  "identifier": "app.relayless.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Relayless",
    "shortDescription": "Direct, resumable, verified large-file transfer",
    "longDescription": "Relayless sends very large files directly between two computers, survives disconnections and restarts, and verifies every byte.",
    "category": "Utility",
    "copyright": "© 2026 Relayless",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
